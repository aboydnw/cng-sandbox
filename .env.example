# .env.example
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# PostgreSQL (defaults work for local development)
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=sandbox_dev_password
POSTGRES_DB=postgis
POSTGRES_PORT=5439

# Cloudflare R2 (S3-compatible object store)
# Create a bucket and API token at https://dash.cloudflare.com/ → R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your_public_bucket_url.r2.dev
# Required for path-style S3 access with Cloudflare R2
AWS_VIRTUAL_HOSTING=FALSE

S3_BUCKET=sandbox-data

# Production only (not needed for local development)
# SITE_ADDRESS=storytelling.developmentseed.org
# VIEWER_SITE_ADDRESS=viewer.storytelling.developmentseed.org
# VITE_VIEWER_ORIGIN=https://viewer.storytelling.developmentseed.org
# AUTH_USER=demo
# AUTH_PASSWORD_HASH=$$2a$$14$$...
# Viewer subdomain for embeddable stories. VIEWER_SITE_ADDRESS must point at
# the same Hetzner host (Caddy auto-provisions the cert from the new server
# block). VITE_VIEWER_ORIGIN is read at frontend build time so the embed
# snippet emits an absolute URL pointing at the viewer subdomain — without
# it, the snippet falls back to window.location.origin (the auth-gated
# main domain) and end users will hit a login prompt.

# GitHub (for bug report integration)
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=owner/repo

# Reader-facing "Ask this map" chat (disabled by default)
# These are backend settings. Put them in this repo-root .env file, not in
# frontend/.env.local, so Docker Compose can pass them to ingestion.
CHAT_ENABLED=false
ANTHROPIC_API_KEY_CHAT=
CHAT_MODEL=claude-haiku-4-5
# CHAT_DAILY_TOKEN_BUDGET=2000000
# CHAT_MAX_TOKENS=1024
# CHAT_RATE_LIMIT=10/minute
# CHAT_MAX_TURNS=20
